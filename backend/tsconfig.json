{
  "compilerOptions": {
    /* 1. Environment & Output */
    "target": "ES2021", // Nâng lên ES2021 (ổn định cho Node 16+), file 2 để 'esnext' có thể hơi rủi ro
    "module": "commonjs", // Chuẩn cho Node.js backend
    "lib": ["ESNext"], // Cho phép dùng các method mới nhất của JS
    "rootDir": "./src",
    "outDir": "./dist",

    /* 2. Module Resolution & Interop */
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* 3. Decorators (QUAN TRỌNG cho NestJS/TypeORM - từ File 1) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    /* 4. Strict Type-Checking (Nâng cao - từ File 2) */
    "strict": true,
    "noUncheckedIndexedAccess": true, // Rất hay: Bắt buộc check null khi truy cập mảng/object
    "exactOptionalPropertyTypes": true, // Nghiêm ngặt hơn với các thuộc tính optional
    "noImplicitReturns": true, // Bắt buộc mọi hàm phải return rõ ràng
    "noFallthroughCasesInSwitch": true, // Chặn việc quên 'break' trong switch-case

    /* 5. Debugging & Declaration (Từ File 2) */
    "sourceMap": true, // Giúp debug code TS dễ hơn
    "declaration": true, // Tạo file .d.ts (tốt nếu project là library)
    "declarationMap": true,

    /* 6. Types & Frameworks */
    // Kết hợp cả 'node' (cho process, fs...) và 'reflect-metadata' (cho NestJS)
    "types": ["node", "reflect-metadata"],

    // Giữ lại nếu bạn có code React trong này, nếu chỉ làm Backend thuần thì có thể bỏ dòng này
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}
